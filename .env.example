# .env.example — template for local tooling. Copy to .env.local and fill in real values.
#   cp .env.example .env.local
#
# .env.local is git-ignored and must NEVER be committed: this repo is served
# publicly via GitHub Pages, so anything committed here becomes public.
#
# None of these values are read by index.html — there is no build step and the
# page runs from file://. They exist only for local scripts/CLI tooling.

# Anthropic API key for local tooling (starts with sk-ant-).
ANTHROPIC_API_KEY=

# OpenRouter key (starts with sk-or-v1-). Only needed if a local script calls
# OpenRouter instead of the Anthropic API directly.
OPENROUTER_API_KEY=
